# General settings
theme = light:Ayu Light,dark:Ayu
font-size = 16
font-family = "FiraCode Nerd Font Mono"
window-height = 25
window-width = 80
unfocused-split-opacity = 0.5
background-opacity = 0.95
background-blur = 25
window-save-state = always
window-new-tab-position = end

# Notify
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 10s

# Working directory
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = true

# Keybindings
# These outer Ghostty split bindings previously used Ctrl-h/j/k/l.
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

# Ctrl-number has no distinct legacy terminal encoding, so Ghostty sends a plain digit.
# `csi:` adds ESC [, then xterm's modifyOtherKeys payload encodes Ctrl (`5`)
# and the digit's ASCII code (`49`-`57`); tmux decodes these as C-1 through C-9.
keybind = ctrl+1=csi:27;5;49~
keybind = ctrl+2=csi:27;5;50~
keybind = ctrl+3=csi:27;5;51~
keybind = ctrl+4=csi:27;5;52~
keybind = ctrl+5=csi:27;5;53~
keybind = ctrl+6=csi:27;5;54~
keybind = ctrl+7=csi:27;5;55~
keybind = ctrl+8=csi:27;5;56~
keybind = ctrl+9=csi:27;5;57~
